# Copy to .env and fill in. Without SMTP_URL/MAIL_FROM, emails are written to
# data/outbox/ instead of being sent (handy for development).

# SMTP connection, e.g. from Postmark, Resend, Mailgun, Fastmail, Google Workspace…
# smtps://USER:PASSWORD@smtp.example.com:465   (URL-encode special characters in the password)
SMTP_URL=

# Address emails are sent from (must be allowed by your SMTP provider).
# Your name is added as the display name; replies go to your login email.
MAIL_FROM=

# Public address of the app, used in testimonial links. Required in production.
# APP_URL=https://crm.example.com

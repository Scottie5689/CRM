{
  "name": "crm",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "user:create": "node server/create-user.js",
    "check": "svelte-check"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "concurrently": "^10.0.7",
    "svelte": "^5.57.3",
    "svelte-check": "^4.0.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.5.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
